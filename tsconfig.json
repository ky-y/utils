{
    "compilerOptions": {
        "target": "es2019",
        "module": "es2022",
        "types": ["vite/client", "node"],
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": true,
        "baseUrl": "./",
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "moduleResolution": "bundler",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts"]
}
